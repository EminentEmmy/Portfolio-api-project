

@host = http://localhost:5220


# PART 1: WORKED EXAMPLE, steps 1-12, in order


### Step 1. Create asset ACME -> 201
POST {{host}}/api/assets
Content-Type: application/json

{ "symbol": "ACME", "name": "Acme Corp", "assetType": "Stock", "currentPrice": 50.00 }

### Step 2. Create asset GOVB -> 201
POST {{host}}/api/assets
Content-Type: application/json

{ "symbol": "GOVB", "name": "Gov Bond 2030", "assetType": "Bond", "currentPrice": 980.00 }

### Step 3. Create asset INDX -> 201
POST {{host}}/api/assets
Content-Type: application/json

{ "symbol": "INDX", "name": "Global Index Fund", "assetType": "Fund", "currentPrice": 100.00 }

### Step 4. Create portfolio "Retirement" -> 201 (id 1), ownerEmail stored as ada@example.com
POST {{host}}/api/portfolios
Content-Type: application/json

{ "name": "Retirement", "ownerEmail": "Ada@Example.com" }

### Step 5. Buy ACME 100 @ 50, fee 10 -> 201 (id 1), netAmount 5010.00, realizedPnl null
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "ACME", "type": "Buy", "quantity": 100, "unitPrice": 50, "fee": 10 }

### Step 6. Buy ACME 100 @ 54, fee 10 -> 201 (id 2)
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "ACME", "type": "Buy", "quantity": 100, "unitPrice": 54, "fee": 10 }

### Step 7. Sell ACME 50 @ 60, fee 10 -> 201 (id 3), grossAmount 3000.00, netAmount 2990.00, realizedPnl 385.00
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "ACME", "type": "Sell", "quantity": 50, "unitPrice": 60, "fee": 10 }

### Step 8. Buy GOVB 10 @ 980, fee 0 -> 201
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "GOVB", "type": "Buy", "quantity": 10, "unitPrice": 980, "fee": 0 }

### Step 9. Buy INDX 40.5 @ 100, fee 0 -> 201
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "INDX", "type": "Buy", "quantity": 40.5, "unitPrice": 100, "fee": 0 }

### Step 10a. PUT price ACME 58.00 -> 200
PUT {{host}}/api/assets/ACME/price
Content-Type: application/json

{ "price": 58.00 }

### Step 10b. PUT price GOVB 1000.00 -> 200
PUT {{host}}/api/assets/GOVB/price
Content-Type: application/json

{ "price": 1000.00 }

### Step 10c. PUT price INDX 110.00 -> 200
PUT {{host}}/api/assets/INDX/price
Content-Type: application/json

{ "price": 110.00 }

### Step 11. GET holdings -> 200, order GOVB, ACME, INDX
# GOVB 10  980.00  9800.00 1000.00 10000.00 200.00 2.04  0.00
# ACME 150 52.10   7815.00 58.00   8700.00  885.00 11.32 385.00
# INDX 40.5 100.00 4050.00 110.00  4455.00  405.00 10.00 0.00
GET {{host}}/api/portfolios/1/holdings

### Step 12. GET summary -> 200
# holdingsCount 3, totalMarketValue 23155.00, totalCostBasis 21665.00,
# unrealizedPnl 1490.00, unrealizedPnlPercent 6.88, realizedPnl 385.00, totalReturn 1875.00
# allocation: Bond 10000.00 43.19, Stock 8700.00 37.57, Fund 4455.00 19.24
GET {{host}}/api/portfolios/1/summary


# PART 2: ERROR CASES 


### Duplicate asset, " acme " normalised -> 409
POST {{host}}/api/assets
Content-Type: application/json

{ "symbol": " acme ", "name": "Acme Corp", "assetType": "Stock", "currentPrice": 50.00 }

### Invalid symbol -> 400
POST {{host}}/api/assets
Content-Type: application/json

{ "symbol": "AC-ME!", "name": "Bad", "assetType": "Stock", "currentPrice": 10.00 }

### Get asset, lowercase symbol -> 200
GET {{host}}/api/assets/acme

### Unknown asset -> 404, detail "Asset 'ZZZZ' does not exist."
GET {{host}}/api/assets/ZZZZ

### List assets by type -> 200
GET {{host}}/api/assets?type=Stock

### List assets, unknown type -> 400
GET {{host}}/api/assets?type=Crypto

### PUT price, negative -> 400
PUT {{host}}/api/assets/ACME/price
Content-Type: application/json

{ "price": -1 }

### PUT price, unknown symbol -> 404
PUT {{host}}/api/assets/ZZZZ/price
Content-Type: application/json

{ "price": 10 }

### Duplicate portfolio name, same owner -> 409
POST {{host}}/api/portfolios
Content-Type: application/json

{ "name": "Retirement", "ownerEmail": "ada@example.com" }

### Bad email -> 400
POST {{host}}/api/portfolios
Content-Type: application/json

{ "name": "X", "ownerEmail": "not-an-email" }

### List portfolios -> 200
GET {{host}}/api/portfolios?ownerEmail=ada@example.com

### List portfolios without email -> 400
GET {{host}}/api/portfolios

### Get portfolio -> 200
GET {{host}}/api/portfolios/1

### Unknown portfolio -> 404
GET {{host}}/api/portfolios/999

### Transaction, quantity 0 -> 400, errors.quantity "Quantity must be greater than 0."
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "ACME", "type": "Buy", "quantity": 0, "unitPrice": 50, "fee": 0 }

### Transaction, negative fee -> 400
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "ACME", "type": "Buy", "quantity": 1, "unitPrice": 50, "fee": -5 }

### Transaction, unknown type -> 400
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "ACME", "type": "Hold", "quantity": 1, "unitPrice": 50, "fee": 0 }

### Transaction, unknown symbol -> 404
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "ZZZZ", "type": "Buy", "quantity": 1, "unitPrice": 50, "fee": 0 }

### Transaction on unknown portfolio -> 404
POST {{host}}/api/portfolios/999/transactions
Content-Type: application/json

{ "symbol": "ACME", "type": "Buy", "quantity": 1, "unitPrice": 50, "fee": 0 }

### Oversell -> 409, detail "Cannot sell 500 ACME; portfolio 1 holds 150."
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "ACME", "type": "Sell", "quantity": 500, "unitPrice": 60, "fee": 0 }

### Holdings unchanged after the oversell -> ACME still 150
GET {{host}}/api/portfolios/1/holdings

### Transaction history, newest first, filtered -> 200
GET {{host}}/api/portfolios/1/transactions?symbol=ACME&type=Sell&from=2026-10-01&to=2026-12-31&page=1&pageSize=20

### Transaction history, unknown portfolio -> 404
GET {{host}}/api/portfolios/999/transactions

### Delete portfolio that has transactions -> 409
DELETE {{host}}/api/portfolios/1


# PART 3: SECOND PORTFOLIO (empty, never-held sell, delete)


### Create a second, empty portfolio -> 201 (id 2)
POST {{host}}/api/portfolios
Content-Type: application/json

{ "name": "Spare", "ownerEmail": "ada@example.com" }

### Sell an asset never held -> 409, detail "Cannot sell 1 ACME; portfolio 2 holds 0."
POST {{host}}/api/portfolios/2/transactions
Content-Type: application/json

{ "symbol": "ACME", "type": "Sell", "quantity": 1, "unitPrice": 60, "fee": 0 }

### Summary of an empty portfolio -> all zeros, allocation []
GET {{host}}/api/portfolios/2/summary

### Holdings of an empty portfolio -> 200, []
GET {{host}}/api/portfolios/2/holdings

### Delete the empty portfolio -> 204
DELETE {{host}}/api/portfolios/2


# PART 4: SCENARIO 13 (changes portfolio 1; run last)


### Sell the remaining 150 ACME -> 201
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "ACME", "type": "Sell", "quantity": 150, "unitPrice": 58, "fee": 0 }

### Buy 10 ACME @ 70.00 -> 201
POST {{host}}/api/portfolios/1/transactions
Content-Type: application/json

{ "symbol": "ACME", "type": "Buy", "quantity": 10, "unitPrice": 70.00, "fee": 0 }

### Holdings -> ACME averageCost 70.00
GET {{host}}/api/portfolios/1/holdings

